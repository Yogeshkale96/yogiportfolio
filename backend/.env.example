# Copy this file to .env and fill in real values. Never commit .env.

# Server (Render sets PORT automatically)
PORT=5000

# Database - Option A: single connection URL (recommended for hosted MySQL)
# DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/portfolio_inquiries

# Database - Option B: individual values
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=portfolio_inquiries

# Set DB_SSL=true for hosted MySQL (Aiven, TiDB Cloud, Railway, etc.)
DB_SSL=false
# Set to false only if the provider uses a self-signed certificate
DB_SSL_REJECT_UNAUTHORIZED=true

# Auth - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_long_random_string
JWT_EXPIRES_IN=7d

# Admin user created by `npm run seed`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
